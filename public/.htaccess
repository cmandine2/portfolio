# Apache configuration served by the OVH hosting (copied as-is from public/ to dist/).

ErrorDocument 404 /404.html

RewriteEngine On

# One hop to the canonical address: HTTPS, without www.
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !=on
RewriteRule ^ https://amandinecousin.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://amandinecousin.com%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # No script on the site. Google Fonts and the inline <style> of each page are the only exceptions.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"

  # File names under /_astro/ contain a hash: they can be cached for a year.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
