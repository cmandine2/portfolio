---
import { render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WaveEdge from "../../../../components/WaveEdge.astro";
import { languages, ui, type Lang } from "../../../../i18n/ui";
import {
  getPrivacyPages,
  getPublishedProjects,
  type PrivacyPage,
} from "../../../../lib/projects";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of languages) {
    const projects = await getPublishedProjects(lang);
    for (const page of await getPrivacyPages(lang)) {
      const project = projects.find((item) => item.slug === page.slug);
      if (!project) continue;
      paths.push({
        params: { lang, slug: page.slug },
        props: { page, appName: project.entry.data.title },
      });
    }
  }
  return paths;
}

interface Props {
  page: PrivacyPage;
  appName: string;
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const { page, appName } = Astro.props;
const { summary, updated, published } = page.entry.data;
const { Content, headings } = await render(page.entry);
const contents = headings.filter((heading) => heading.depth === 2);
const updatedText =
  updated &&
  new Intl.DateTimeFormat(lang, { dateStyle: "long" }).format(updated);
---

<BaseLayout
  lang={lang}
  title={`${appName} — ${t.privacy.title}`}
  description={`${t.privacy.title} — ${t.privacy.app} ${appName}`}
>
  <section class="on-lagoon">
    <div class="container hero">
      <nav class="breadcrumb" aria-label={t.breadcrumb}>
        <a href={`/${lang}/projects/${page.slug}/`}>{appName}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{t.privacy.label}</span>
      </nav>
      <h1>{t.privacy.title}</h1>
      <p class="meta">
        {`${t.privacy.app} ${appName} `}
        {updatedText && (
          <>
            · {t.privacy.updated}
            {lang === "fr" ? " : " : ": "}
            <time datetime={updated?.toISOString().slice(0, 10)}>
              {updatedText}
            </time>
          </>
        )}
      </p>
    </div>
  </section>
  <WaveEdge />

  <div class="container body">
    {!published && <p class="draft">{t.privacy.draft}</p>}
    {summary.length > 0 && (
      <section class="summary on-saffron" aria-labelledby="summary-title">
        <h2 id="summary-title">{t.privacy.summaryTitle}</h2>
        <ul>
          {summary.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>
    )}
    <nav class="contents" aria-labelledby="contents-title">
      <h2 id="contents-title">{t.privacy.contents}</h2>
      <ol>
        {contents.map((heading) => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="card prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: 40px 48px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 8px;
    margin-bottom: 28px;
    font-size: 16px;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  h1 {
    margin-bottom: 16px;
    font-weight: 700;
    font-size: clamp(32px, 5.5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .meta {
    max-width: 52ch;
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.45;
  }

  .body {
    max-width: 920px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 56px 88px;
  }

  .draft {
    padding: 12px 20px;
    border: 2px dashed var(--abyss);
    border-radius: 16px;
    font-weight: 600;
    color: var(--abyss);
  }

  .summary {
    padding: clamp(24px, 4vw, 44px);
    border-radius: var(--radius);
  }

  .summary h2 {
    margin-bottom: 8px;
    font-size: 24px;
    font-weight: 700;
  }

  .summary ul {
    padding-left: 22px;
    font-size: 19px;
    font-weight: 500;
  }

  .summary li + li {
    margin-top: 6px;
  }

  .contents {
    padding: 24px 28px;
    border: 2px solid var(--abyss);
    border-radius: 24px;
  }

  .contents h2 {
    margin-bottom: 8px;
    font-size: 20px;
    font-weight: 700;
    color: var(--abyss);
  }

  .contents ol {
    padding-left: 22px;
    columns: 2 260px;
    column-gap: 32px;
  }

  .contents a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .prose {
    counter-reset: section;
  }

  .prose :global(h2) {
    counter-increment: section;
    margin: 32px 0 10px;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.25;
    color: var(--abyss);
  }

  .prose :global(h2::before) {
    content: counter(section) ". ";
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0;
  }

  .prose :global(* + p),
  .prose :global(* + ul),
  .prose :global(* + ol) {
    margin-top: 12px;
  }

  .prose :global(h2 + *) {
    margin-top: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }
</style>
