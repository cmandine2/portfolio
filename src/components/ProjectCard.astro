---
import Screenshot from "./Screenshot.astro";
import { ui, type Lang } from "../i18n/ui";
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = ui[lang];
const { title, summary, platforms, status, images } = project.entry.data;
const cover = images[0];
---

<article class="card card--featured">
  <div class="visual">
    <div class="bubble">
      {cover && (
        <div class="phone">
          <Screenshot
            lang={lang}
            src={cover.src}
            alt={cover.alt}
            variant="frame"
            sizes="150px"
          />
        </div>
      )}
    </div>
  </div>
  <div class="text">
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <ul class="tags">
      {platforms.map((platform) => (
        <li class="tag">{platform}</li>
      ))}
      {status === "upcoming" && (
        <li class="tag tag--status">{t.status.upcoming}</li>
      )}
    </ul>
    <a class="button" href={`/${lang}/projects/${project.slug}/`}>
      {t.home.readStory}
      <span class="visually-hidden"> : {title}</span>
      <svg aria-hidden="true" width="30" height="18" viewBox="0 0 34 18">
        <path d="M2 9 C 10 3, 18 15, 31 9 M25 4 l6 5 -6 5"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  article {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 56px;
  }

  .visual {
    flex: 1 1 260px;
    display: flex;
    justify-content: center;
  }

  .bubble {
    width: min(100%, 300px);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--lagoon);
    border-radius: 50%;
  }

  .phone {
    width: 48%;
    transform: rotate(-6deg);
  }

  .text {
    flex: 999 1 380px;
    min-width: 0;
  }

  h3 {
    margin-bottom: 12px;
    font-weight: 700;
    font-size: clamp(28px, 9vw, 60px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--abyss);
  }

  .summary {
    max-width: 38ch;
    margin-bottom: 18px;
    font-size: 21px;
    line-height: 1.5;
  }

  .tags {
    margin-bottom: 28px;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
