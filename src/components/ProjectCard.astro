---
import { Image } from "astro:assets";
import DeviceShowcase from "./DeviceShowcase.astro";
import { ui, type Lang } from "../i18n/ui";
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = ui[lang];
const { title, summary, platforms, status, images, icon } = project.entry.data;
---

<article class="card card--featured">
  <div class="visual">
    <DeviceShowcase lang={lang} images={images} tone="lagoon" />
  </div>
  <div class="text">
    <div class="title-row">
      {icon && (
        <Image
          class="app-icon"
          src={icon}
          alt={t.project.iconAlt.replace("{name}", title)}
          width={64}
          height={64}
          densities={[1, 2, 3]}
        />
      )}
      <h3>{title}</h3>
    </div>
    <p class="summary">{summary}</p>
    <ul class="tags">
      {platforms.map((platform) => (
        <li class="tag">{platform}</li>
      ))}
      {status === "upcoming" && (
        <li class="tag tag--status">{t.status.upcoming}</li>
      )}
    </ul>
    <a class="button" href={`/${lang}/projects/${project.slug}/`}>
      {t.home.readStory}
      <span class="visually-hidden"> : {title}</span>
      <svg aria-hidden="true" width="30" height="18" viewBox="0 0 34 18">
        <path d="M2 9 C 10 3, 18 15, 31 9 M25 4 l6 5 -6 5"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  article {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 56px;
  }

  .visual {
    flex: 1 1 260px;
    display: flex;
    justify-content: center;
  }

  .text {
    flex: 999 1 380px;
    min-width: 0;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-bottom: 12px;
  }

  .app-icon {
    flex: 0 0 auto;
    width: clamp(48px, 8vw, 64px);
    height: auto;
    border-radius: 22.5%;
  }

  h3 {
    min-width: 0;
    font-weight: 700;
    font-size: clamp(28px, 9vw, 60px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--abyss);
  }

  .summary {
    max-width: 38ch;
    margin-bottom: 18px;
    font-size: 21px;
    line-height: 1.5;
  }

  .tags {
    margin-bottom: 28px;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
